{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -lc \"mkdir -p /app/casino/storage/logs && touch /app/casino/storage/logs/laravel.log && tail -n 0 -F /app/casino/storage/logs/laravel.log >&2 & php -d variables_order=EGPCS -S 0.0.0.0:${PORT:-8080} -t /app /app/railway-router.php\"",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
